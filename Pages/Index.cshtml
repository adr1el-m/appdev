@page
@{
    Layout = null;
    var regions = new[] { "NCR", "Cordillera Administrative Region", "Ilocos Region", "Cagayan Valley", "Central Luzon", "CALABARZON", "MIMAROPA", "Bicol Region", "Western Visayas", "Central Visayas", "Eastern Visayas", "Zamboanga Peninsula", "Northern Mindanao", "Davao Region", "SOCCSKSARGEN", "Caraga", "BARMM" };
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="theme-color" content="#f7f7f3"/><meta name="description" content="STAR-LINK connects educators across the Philippines through regional collaboration, research, and shared teaching resources."/>
    <title>STAR-LINK — Philippine Teachers Hub</title><link rel="icon" href="/star-link-mark.png"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet"/><link rel="stylesheet" href="/css/site.css"/>
</head>
<body>
<div class="app-shell">
    <aside class="sidebar" id="sidebar">
        <a class="brand" href="#home" aria-label="STAR-LINK home"><span class="brand-symbol">s<span>✳</span></span><span class="brand-name">star<span>-link</span><small>TEACHERS HUB</small></span></a>
        <div class="side-label">WORKSPACE</div>
        <nav class="side-nav" aria-label="Main navigation">
            <button class="nav-link active" data-view="home"><span class="nav-ico">◫</span>Overview</button>
            <button class="nav-link" data-view="map"><span class="nav-ico">⌖</span>Regional map</button>
            <button class="nav-link" data-view="resources"><span class="nav-ico">▤</span>Research & resources</button>
            <button class="nav-link" data-view="forum"><span class="nav-ico">◌</span>Community forum</button>
            <button class="nav-link" data-view="profile"><span class="nav-ico">♙</span>Educator profiles</button>
        </nav>
        <div class="side-label side-label-spaced">MANAGEMENT</div>
        <nav class="side-nav"><button class="nav-link" data-view="admin"><span class="nav-ico">▥</span>Admin insights<span class="admin-pill">DEMO</span></button></nav>
        <div class="sidebar-bottom"><div class="help-card"><div class="help-icon">✳</div><b>Better together.</b><p>Share what works. Learn from every region.</p><a href="#community" data-view-link="forum">Visit the community <span>↗</span></a></div><button class="user-chip" data-view="profile"><span class="avatar avatar-me">AR</span><span><b id="sideName">Alex Rivera</b><small>Educator · demo profile</small></span><span class="dots">•••</span></button></div>
    </aside>
    <main class="main-area">
        <header class="topbar"><button class="mobile-menu" id="mobileMenu" aria-label="Open navigation">☰</button><div class="crumb"><span>Workspace</span><i>/</i><b id="pageCrumb">Overview</b></div><div class="top-actions"><span class="demo-tag"><i></i> Sample workspace</span><button class="icon-button" aria-label="Notifications">♧<b class="notify-dot"></b></button><button class="avatar avatar-me top-avatar" data-view="profile" title="Your profile">AR</button></div></header>
        <div class="content-wrap">
            <section class="view active" id="view-home">
                <div class="welcome-row"><div><div class="eyebrow"><span class="eyebrow-line"></span> NATIONAL TEACHER NETWORK</div><h1>Good morning, <span id="welcomeName">Alex</span><span class="wave">✳</span></h1><p class="lede">Small ideas can make a big difference. Here’s what’s happening across your network.</p></div><button class="button button-primary" data-view="resources"><span>＋</span> Share a resource</button></div>
                <div class="hero-card"><div class="hero-copy"><span class="hero-kicker">YOUR CLASSROOM. OUR SHARED FUTURE.</span><h2>Great teaching travels<br/>further <em>together.</em></h2><p>Connect with educators across the Philippines, share what works, and find ideas that make a difference in your classroom.</p><button class="button button-light" data-view="map">Explore the regional map <span>↗</span></button></div><div class="hero-art" aria-hidden="true"><div class="sun"></div><div class="hill hill-back"></div><div class="hill hill-front"></div><div class="art-orbit orbit-one"></div><div class="art-orbit orbit-two"></div><span class="art-pin pin-one">✳</span><span class="art-pin pin-two">✳</span><span class="art-pin pin-three">✳</span><div class="art-label">17 REGIONS <span>·</span> ONE COMMUNITY</div></div><div class="hero-noise"></div></div>
                <div class="section-head"><div><span class="eyebrow">A NETWORK IN MOTION</span><h2>Community at a glance</h2></div><button class="text-action" data-view="admin">View insights <span>→</span></button></div>
                <div class="stats-grid"><article class="stat-card"><div class="stat-top"><span>EDUCATORS</span><span class="stat-icon mint">♙</span></div><div class="stat-value" id="statEducators">—</div><div class="stat-foot"><span class="live-dot"></span> Across <b id="statRegions">17</b> regions</div></article><article class="stat-card"><div class="stat-top"><span>SHARED RESOURCES</span><span class="stat-icon peach">▤</span></div><div class="stat-value" id="statResources">—</div><div class="stat-foot">Ideas from the classroom, for the classroom</div></article><article class="stat-card"><div class="stat-top"><span>ACTIVE DISCUSSIONS</span><span class="stat-icon lavender">◌</span></div><div class="stat-value" id="statTopics">—</div><div class="stat-foot"><span class="live-dot"></span> <span id="statReplies">—</span> educator replies</div></article></div>
                <div class="home-columns"><section class="panel region-panel"><div class="panel-heading"><div><span class="eyebrow">FIND YOUR PEOPLE</span><h3>Across the islands</h3></div><button class="round-arrow" data-view="map" aria-label="Open regional map">↗</button></div><p class="panel-sub">Educators learning from one another, wherever they are.</p><div class="mini-regions" id="homeRegions"></div><button class="panel-link" data-view="map">Explore all regions <span>→</span></button></section><section class="panel activity-panel"><div class="panel-heading"><div><span class="eyebrow">HAPPENING NOW</span><h3>From the community</h3></div><button class="text-action" data-view="forum">See all <span>→</span></button></div><div id="homeTopics" class="activity-list"></div></section></div>
            </section>
            <section class="view" id="view-map"><div class="page-title"><div><div class="eyebrow">GEOGRAPHIC COLLABORATION</div><h1>Regional map</h1><p class="lede">See where educators are connecting. Choose a region to explore local voices and shared work.</p></div><span class="info-chip">⌖ &nbsp; Philippines · 17 regions</span></div><div class="map-layout"><section class="panel map-panel"><div class="map-toolbar"><div><b>Educator network</b><small>Hover or select a region</small></div><span class="map-legend"><i></i> Educator activity</span></div><div class="map-stage"><svg id="philMap" viewBox="0 0 760 860" role="img" aria-label="Interactive map of Philippine administrative regions"><text x="380" y="420" text-anchor="middle" fill="#788079" font-size="16">Loading region boundaries…</text></svg><div class="map-ocean-label ocean-north">PHILIPPINE SEA</div><div class="map-ocean-label ocean-west">WEST PHILIPPINE SEA</div></div><div class="map-foot"><span><i class="map-dot"></i> Regional educators</span><span>Boundary source: GeoJSON administrative regions</span></div></section><aside class="panel region-detail" id="regionDetail"><div class="detail-illustration"><span>✳</span><small>CONNECTED, WHEREVER YOU ARE</small></div><div class="eyebrow">SELECT A REGION</div><h3>Many places.<br/><em>One community.</em></h3><p>Select any highlighted area on the map to see educator profiles, active conversations, and resources from that region.</p><div class="detail-callout"><span class="detail-icon">⌖</span><span><b>17 regions</b><small>Connected through shared practice</small></span></div></aside></div></section>
            <section class="view" id="view-resources"><div class="page-title"><div><div class="eyebrow">CLASSROOM KNOWLEDGE, SHARED</div><h1>Research & resources</h1><p class="lede">Find action research, lesson ideas, and extension projects made by fellow educators.</p></div><button class="button button-primary" id="openResourceForm"><span>＋</span> Share a resource</button></div><div class="panel filter-panel"><label class="search-box"><span>⌕</span><input id="resourceSearch" type="search" placeholder="Search by title, topic, or educator…"/><kbd>⌘ K</kbd></label><div class="filter-selects"><label><span>SUBJECT</span><select id="subjectFilter"><option value="">All subjects</option></select></label><label><span>REGION</span><select id="resourceRegionFilter"><option value="">All regions</option></select></label><label><span>TYPE</span><select id="typeFilter"><option value="">All types</option></select></label></div></div><div class="results-line"><span id="resourceCount">Showing resources</span><button id="clearResourceFilters" class="text-action">Clear filters <span>↺</span></button></div><div class="resource-grid" id="resourceGrid"></div><div class="empty-state hidden" id="resourceEmpty"><span>⌕</span><h3>No matching resources yet</h3><p>Try another search or clear a filter to see more shared work.</p></div></section>
            <section class="view" id="view-forum"><div class="page-title"><div><div class="eyebrow">LEARN WITH YOUR PEERS</div><h1>Community forum</h1><p class="lede">Ask a question, share what worked, and make room for ideas from every region.</p></div><button class="button button-primary" id="openTopicForm"><span>＋</span> Start a discussion</button></div><div class="forum-toolbar"><div class="forum-tabs"><button class="forum-tab selected" data-forum-filter="all">All conversations</button><button class="forum-tab" data-forum-filter="following">My region</button></div><label class="compact-select"><span>⌖</span><select id="forumRegionFilter"><option value="">All regions</option></select></label></div><div class="forum-layout"><div id="topicList" class="topic-list"></div><aside class="panel forum-aside"><div class="forum-aside-top"><span class="eyebrow">COMMUNITY PROMPT</span><span class="prompt-spark">✳</span></div><h3>What’s one small thing that made learning click this week?</h3><p>Share the moment, activity, or question you’ll carry into next week. Your idea might be exactly what another teacher needs.</p><button class="panel-link" id="promptStart">Add your voice <span>→</span></button><div class="aside-divider"></div><span class="eyebrow">GOOD CONVERSATIONS</span><ul class="guidelines"><li>Lead with curiosity</li><li>Share context that helps others</li><li>Keep learner privacy in mind</li></ul></aside></div></section>
            <section class="view" id="view-profile"><div class="page-title"><div><div class="eyebrow">YOUR PLACE IN THE NETWORK</div><h1>Educator profiles</h1><p class="lede">Meet educators across regions, or update the information others see about you.</p></div><button class="button button-primary" id="editProfile"><span>✎</span> Edit my profile</button></div><div class="profile-layout"><section class="panel profile-card"><div class="profile-cover"><div class="cover-shape cover-a"></div><div class="cover-shape cover-b"></div><span>YOUR EXPERIENCE MAKES US STRONGER</span></div><div class="profile-main"><span class="avatar avatar-large avatar-me" id="profileInitials">AR</span><div class="profile-name"><span class="verified-tag"><i>✓</i> EDUCATOR</span><h2 id="profileName">Alex Rivera</h2><p id="profileSchool">Mabini Integrated School</p></div><div class="profile-tags"><span id="profileRegionTag">CALABARZON</span><span id="profileSubjectTag">Science</span></div><p class="profile-bio" id="profileBio">STEM educator sharing hands-on science activities and classroom research.</p><div class="profile-meta"><span>⌖ <b id="profileRegion">CALABARZON</b></span><span>▧ <b id="profileSubject">Science</b></span><span>✳ Member of STAR-LINK</span></div></div></section><section class="panel directory-card"><div class="panel-heading"><div><span class="eyebrow">PEER DIRECTORY</span><h3>Educators to know</h3></div><label class="directory-search"><span>⌕</span><input id="profileSearch" placeholder="Find an educator"/></label></div><div id="profileDirectory" class="directory-list"></div></section></div></section>
            <section class="view" id="view-admin"><div class="page-title"><div><div class="eyebrow">PLATFORM PULSE · DEMO ANALYTICS</div><h1>Admin insights</h1><p class="lede">A clear view of how educators are sharing, connecting, and learning across the network.</p></div><button class="button button-outline" id="refreshAnalytics">↻ &nbsp; Refresh view</button></div><div class="panel admin-gate" id="adminGate"><span class="stat-icon lavender">▥</span><div><h3>Administrator access</h3><p>Sign in to view aggregated platform metrics and regional insights.</p></div><button class="button button-primary" id="adminSignIn">Administrator sign in <span>→</span></button><small>Local demo passcode: <code>demo-admin</code>. Set <code>STARLINK_ADMIN_PASSCODE</code> before sharing this demo.</small></div><div id="adminDashboard" class="hidden"><div class="admin-note"><span>✳</span><p><b>Sample workspace data</b> &nbsp;These demo insights are calculated from the sample educator, resource, and discussion records stored in this project.</p></div><div class="stats-grid admin-stats"><article class="stat-card"><div class="stat-top"><span>EDUCATOR PROFILES</span><span class="stat-icon mint">♙</span></div><div class="stat-value" id="adminEducators">—</div><div class="stat-foot">Registered sample profiles</div></article><article class="stat-card"><div class="stat-top"><span>SHARED KNOWLEDGE</span><span class="stat-icon peach">▤</span></div><div class="stat-value" id="adminResources">—</div><div class="stat-foot">Resources in the library</div></article><article class="stat-card"><div class="stat-top"><span>COMMUNITY REPLIES</span><span class="stat-icon lavender">◌</span></div><div class="stat-value" id="adminReplies">—</div><div class="stat-foot">Responses across discussion threads</div></article><article class="stat-card"><div class="stat-top"><span>REGIONS REPRESENTED</span><span class="stat-icon blue">⌖</span></div><div class="stat-value"><span id="adminRegionCount">—</span><small> / 17</small></div><div class="stat-foot">Regions with an educator profile</div></article></div><div class="admin-grid"><section class="panel chart-panel"><div class="panel-heading"><div><span class="eyebrow">REGIONAL PARTICIPATION</span><h3>Educators by region</h3></div><span class="chart-caption">sample profiles</span></div><div class="bar-chart" id="regionChart"></div></section><section class="panel insights-panel"><div class="panel-heading"><div><span class="eyebrow">FROM THE DATA</span><h3>Network signals</h3></div></div><div class="insight-list" id="insightList"></div><div class="insight-disclaimer">Signals summarize this sample workspace and are not a measure of real-world regional need.</div></section></div></div></section>
            <footer class="footer"><span>✳ &nbsp;STAR-LINK <small>· A teacher community across the Philippines</small></span><span>Built for educators, wherever they teach.</span></footer>
        </div>
    </main>
</div>
<div class="modal-backdrop hidden" id="modalBackdrop"><section class="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle"><button class="modal-close" id="modalClose" aria-label="Close">×</button><span class="eyebrow" id="modalEyebrow">SHARE WITH YOUR COMMUNITY</span><h2 id="modalTitle">Add your voice</h2><p class="modal-intro" id="modalIntro">A little context helps your fellow educators join in.</p><form id="modalForm"></form><div class="form-message" id="formMessage" role="status"></div></section></div>
<div class="toast" id="toast" role="status"></div>
<script>window.starLinkRegions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(regions));</script><script src="/js/site.js" defer></script>
</body></html>
